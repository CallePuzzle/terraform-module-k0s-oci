apiVersion: k0sctl.k0sproject.io/v1beta1
kind: Cluster
metadata:
  name: k0s-cluster
spec:
  hosts:
  - ssh:
      address: ${public_ip}
      user: ${ssh_user}
      port: 22
      keyPath: ${ssh_private_key_path != null ? ssh_private_key_path : "null"}
    role: controller+worker
    noTaints: true
    privateAddress: ${private_ip}
  k0s:
    version: ${k0s_version}
    dynamicConfig: false
    config:
      apiVersion: k0s.k0sproject.io/v1beta1
      kind: ClusterConfig
      metadata:
        name: k0s-cluster
      spec:
        telemetry:
          enabled: false
        %{ if enable_argocd || enable_traefik || enable_openebs }
        extensions:
          helm:
            repositories:
            %{ if enable_argocd }
            - name: argo
              url: https://argoproj.github.io/argo-helm
            %{ endif }
            %{ if enable_traefik }
            - name: traefik
              url: https://traefik.github.io/charts
            %{ endif }
            %{ if enable_openebs }
            - name: openebs-internal
              url: https://openebs.github.io/openebs
            %{ endif }
            charts:
            %{ if enable_openebs }
            - name: openebs
              chartname: openebs-internal/openebs
              version: "4.5.1"
              namespace: openebs
              order: 0
              values: |
                engines:
                  replicated:
                    mayastor:
                      enabled: false
                lvm-localpv:
                  lvmNode:
                    kubeletDir: /var/lib/k0s/kubelet
                zfs-localpv:
                  zfsNode:
                    kubeletDir: /var/lib/k0s/kubelet
                localpv-provisioner:
                  hostpathClass:
                    isDefaultClass: false
            %{ endif }
            %{ if enable_traefik }
            - name: traefik
              chartname: traefik/traefik
              version: "41.2.0"
              namespace: traefik
              order: 1
              values: |
                ingressClass:
                  name: nginx
                providers:
                  kubernetesIngress:
                    # Argo CD's Ingress health check requires
                    # status.loadBalancer.ingress to be set. Publish the node
                    # IP statically: the chart auto-enables publishedService
                    # for type=LoadBalancer services, and that mode takes
                    # precedence but reads the Service's LB status, which
                    # stays empty forever in k0s (no cloud LB controller).
                    publishedService:
                      enabled: false
                    ingressEndpoint:
                      ip: ${private_ip}
                service:
                  spec:
                    externalIPs:
                      - ${private_ip}
            %{ endif }
            %{ if enable_argocd }
            - name: argo-cd
              chartname: argo/argo-cd
              version: "10.3.2"
              namespace: argocd
              order: 2
              values: |
                ${indent(16, argocd_values)}
            %{ endif }
            %{ if enable_argocd && enable_argocd_apps }
            - name: argocd-apps
              chartname: argo/argocd-apps
              version: "2.0.5"
              namespace: argocd
              order: 3
              values: |
                applications: %{if length(projects) == 0~}{}%{else}
                  %{for project in projects}
                  ${project.name}:
                    namespace: argocd
                    project: ${project.name}
                    source:
                      repoURL: ${project.source.repo_url}
                      targetRevision: ${project.source.target_revision}
                      path: ${project.source.path}
                      %{if project.source.plugin != ""}
                      plugin:
                        name: ${project.source.plugin}
                        env:
                          - name: ENVIRONMENT
                            value: %{if project.environment != null~}${project.environment}%{else}${environment}%{endif}
                      %{endif}
                    destination:
                      server: https://kubernetes.default.svc
                      namespace: argocd
                    %{if project.auto_sync}
                    syncPolicy:
                      automated:
                        prune: true
                    %{endif~}
                  %{endfor~}%{endif~}

                projects: %{if length(projects) == 0~}{}%{else}
                  %{for project in projects}
                  ${project.name}:
                    namespace: argocd
                    description: Project for ${project.name}
                    sourceRepos: ${jsonencode(concat([project.source.repo_url], project.source_repos))}
                    destinations:
                    - namespace: argocd
                      server: https://kubernetes.default.svc
                    - namespace: ${project.destination_namespace}
                      server: https://kubernetes.default.svc
                    clusterResourceWhitelist:
                    - group: ''
                      kind: Namespace
                  %{endfor~}%{endif~}

            %{ endif }
        %{ endif }
